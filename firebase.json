{
  "hosting": {
    "public": ".",
    "ignore": ["firebase.json", ".firebaserc", "firebase/**", "**/.*", "**/node_modules/**", "*.md", ".github/**"],
    "headers": [
      { "source": "version.txt", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "index.html", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
    ]
  },
  "database": { "rules": "firebase/database.rules.json" }
}
