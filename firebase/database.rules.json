{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid",
        "name": { ".validate": "newData.isString() && newData.val().length <= 100" },
        "photo": { ".validate": "newData.isString() && newData.val().length <= 2000" },
        "lastSeen": { ".validate": "newData.isNumber()" }
      }
    },
    "saveMeta": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "$id": {
          ".validate": "$id.length <= 40 && newData.hasChildren(['name', 'city', 'pop', 'savedAt'])",
          "name": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 60" },
          "city": { ".validate": "newData.isString() && newData.val().length <= 60" },
          "date": { ".validate": "newData.isString() && newData.val().length <= 30" },
          "pop": { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "size": { ".validate": "newData.isNumber()" },
          "savedAt": { ".validate": "newData.isNumber() && newData.val() <= now" },
          "$other": { ".validate": false }
        }
      }
    },
    "saveData": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "$id": { ".validate": "$id.length <= 40 && newData.isString() && newData.val().length < 2000000" }
      }
    },
    "region": {
      "meta": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChildren(['owner', 'name', 'pop', 'updatedAt'])",
          "owner": { ".validate": "newData.isString() && newData.val().length <= 100" },
          "name": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 60" },
          "pop": { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "cls": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 5" },
          "score": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000" },
          "year": { ".validate": "newData.isNumber()" },
          "updatedAt": { ".validate": "newData.isNumber() && newData.val() <= now" },
          "$other": { ".validate": false }
        }
      },
      "data": {
        "$uid": {
          ".read": "auth != null",
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.isString() && newData.val().length < 2000000"
        }
      }
    },
    "roomList": {
      ".read": "auth != null",
      ".indexOn": ["updatedAt"],
      "$room": {
        ".write": "auth != null && ((!data.exists() && newData.child('hostUid').val() === auth.uid) || (data.child('hostUid').val() === auth.uid && (!newData.exists() || newData.child('hostUid').val() === auth.uid)))",
        ".validate": "$room.matches(/^[A-Z0-9]{6}$/) && newData.hasChildren(['name', 'hostUid', 'hostName', 'open', 'updatedAt'])",
        "name": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40" },
        "hostUid": { ".validate": "newData.isString()" },
        "hostName": { ".validate": "newData.isString() && newData.val().length <= 100" },
        "private": { ".validate": "newData.isBoolean()" },
        "players": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100" },
        "pop": { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "cityName": { ".validate": "newData.isString() && newData.val().length <= 60" },
        "updatedAt": { ".validate": "newData.isNumber() && newData.val() <= now + 60000" },
        "open": { ".validate": "newData.isBoolean()" },
        "$other": { ".validate": false }
      }
    },
    "rooms": {
      "$room": {
        ".read": "auth != null",
        ".write": "auth != null && !newData.exists() && root.child('roomList/' + $room + '/hostUid').val() === auth.uid",
        "snapshot": {
          ".write": "auth != null && root.child('roomList/' + $room + '/hostUid').val() === auth.uid",
          ".validate": "newData.hasChildren(['seq', 'ep', 'data']) && newData.child('seq').isNumber() && newData.child('data').isString() && newData.child('data').val().length < 3000000"
        },
        "diffs": {
          ".write": "auth != null && root.child('roomList/' + $room + '/hostUid').val() === auth.uid",
          "$d": { ".validate": "newData.hasChildren(['seq', 'ep', 'd']) && newData.child('seq').isNumber() && newData.child('d').isString() && newData.child('d').val().length < 1000000" }
        },
        "actions": {
          ".write": "auth != null && root.child('roomList/' + $room + '/hostUid').val() === auth.uid",
          "$a": {
            ".write": "auth != null && !data.exists() && newData.child('uid').val() === auth.uid",
            ".validate": "newData.hasChildren(['uid', 'tool', 'cells']) && newData.child('tool').isString() && newData.child('tool').val().length <= 16 && newData.child('cells').isString() && newData.child('cells').val().length <= 8000"
          }
        },
        "presence": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.hasChildren(['name', 't']) && newData.child('name').isString() && newData.child('name').val().length <= 100"
          }
        },
        "chat": {
          ".write": "auth != null && root.child('roomList/' + $room + '/hostUid').val() === auth.uid",
          "$m": {
            ".write": "auth != null && !data.exists() && newData.child('uid').val() === auth.uid",
            ".validate": "newData.hasChildren(['uid', 'name', 'text', 't']) && newData.child('name').isString() && newData.child('name').val().length <= 100 && newData.child('text').isString() && newData.child('text').val().length >= 1 && newData.child('text').val().length <= 300"
          }
        },
        "$other": { ".validate": false }
      }
    }
  }
}
